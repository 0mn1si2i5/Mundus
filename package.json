{
  "name": "mundus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-release-notices.mjs",
    "data:places": "node scripts/build-populated-places.mjs",
    "data:development": "node scripts/build-undp-development.mjs",
    "data:cities": "node scripts/build-geonames-major-cities.mjs tmp/geonames",
    "data:verify": "node scripts/verify-generated-data.mjs",
    "release:verify": "node scripts/verify-pages-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:release": "node --test scripts/verify-pages-artifact.test.mjs",
    "test:data-cities": "node --test scripts/build-geonames-major-cities.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm data:verify && pnpm test:data-cities && pnpm test && pnpm test:release && pnpm build && pnpm release:verify"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "d3-geo": "3.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "opencc-js": "1.4.1",
    "prettier": "^3.8.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
